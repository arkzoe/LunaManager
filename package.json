{
  "name": "lunamanager",
  "version": "1.1.2",
  "description": "A visual novel management tool",
  "main": "./out/main/index.js",
  "author": "arkzoe",
  "homepage": "https://github.com/arkzoe/LunaManager",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "chcp 65001 && electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --publish always",
    "build:mac": "npm run build && electron-builder --mac --publish always",
    "build:linux": "npm run build && electron-builder --linux --publish always"
  },
  "build": {
    "appId": "com.arkzoe.lunamanager",
    "productName": "LunaManager",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "!**/.vscode/*",
      "!src/*",
      "!electron.vite.config.{js,ts,mjs,cjs}",
      "!{.eslintcache,eslint.config.mjs,.prettierignore,.prettierrc.yaml,dev-app-update.yml,CHANGELOG.md,README.md}",
      "!{.env,.env.*,.npmrc,pnpm-lock.yaml}",
      "!{tsconfig.json,tsconfig.node.json,tsconfig.web.json}",
      "!{tsconfig.json,tsconfig.node.json,tsconfig.web.json}",
      "!**/node_modules/**/{test,tests,__tests__,benchmark,benchmarks,demo,example,examples}/**",
      "!**/node_modules/**/*.{ts,tsx}",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/{CHANGELOG,changelog,CONTRIBUTING,contributing,README,readme,History,history}*",
      "!**/node_modules/**/{.github,.git,.idea,.vscode,.eslintrc*,eslint.config.*,.prettierrc*,babel.config.*,jest.config.*,tsconfig.*,rollup.config.*,webpack.config.*,vite.config.*}",
      "!**/node_modules/**/build/**/*.{iobj,ipdb,pdb,lib,exp,obj}",
      "!**/node_modules/**/build/**/*.tlog/**",
      "!**/node_modules/**/build/**/obj/**",
      "!**/node_modules/**/deps/**",
      "!**/node_modules/**/src/**/*.{c,cpp,h,hpp}",
      "!**/node_modules/bare-*/prebuilds/{win32-arm64,darwin-*,ios-*,linux-*,android-*}/**",
      "!LICENSES.chromium.html"
    ],
    "asar": {
      "smartUnpack": true
    },
    "extraResources": [
      { "from": "tool/Locale.Emulator", "to": "tool/Locale.Emulator" }
    ],
    "asarUnpack": [
      "resources/**"
    ],
    "afterPack": "build/after-pack.js",
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "executableName": "LunaManager"
    },
    "nsis": {
      "artifactName": "${name}-${version}-setup.${ext}",
      "shortcutName": "${productName}",
      "uninstallDisplayName": "${productName}",
      "createDesktopShortcut": "always",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "icon": "build/icon.icns",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Application requests access to the device's camera.",
        "NSMicrophoneUsageDescription": "Application requests access to the device's microphone.",
        "NSDocumentsFolderUsageDescription": "Application requests access to the user's Documents folder.",
        "NSDownloadsFolderUsageDescription": "Application requests access to the user's Downloads folder."
      },
      "notarize": false
    },
    "dmg": {
      "artifactName": "${name}-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "snap",
        "deb"
      ],
      "maintainer": "electronjs.org",
      "category": "Utility"
    },
    "appImage": {
      "artifactName": "${name}-${version}.${ext}"
    },
    "releaseInfo": {
      "releaseNotesFile": "CHANGELOG.md"
    },
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "arkzoe",
      "repo": "LunaManager"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.9.0",
    "chart.js": "^4.5.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.3.9",
    "fuse.js": "^7.3.0",
    "marked": "^18.0.3",
    "ms": "^2.1.3",
    "pinia": "^3.0.4",
    "unzipper": "^0.12.3",
    "vue-chartjs": "^5.3.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/archiver": "^7.0.0",
    "@types/node": "^22.19.1",
    "@unocss/preset-attributify": "^66.6.8",
    "@unocss/preset-uno": "^66.6.8",
    "@unocss/transformer-directives": "^66.6.8",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "prettier": "^3.7.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.9.3",
    "unocss": "^66.6.8",
    "vite": "^7.2.6",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
